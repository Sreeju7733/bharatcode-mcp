{
  "name": "bharatcode-mcp",
  "version": "1.0.0",
  "description": "Offline-first CLI to bootstrap and manage Model Context Protocol (MCP) servers into BharatCode CLI and Desktop with verified config merging.",
  "type": "module",
  "bin": {
    "bharatcode-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "registry",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "author": "Sreeju S (https://github.com/Sreeju7733)",
  "contributors": [
    "Flovo (https://github.com/flovo-labs)"
  ],
  "homepage": "https://github.com/Sreeju7733/bharatcode-mcp#readme",
  "bugs": {
    "url": "https://github.com/Sreeju7733/bharatcode-mcp/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "typescript",
    "cli",
    "developer-tools",
    "bharatcode",
    "offline-first"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "picocolors": "^1.1.0",
    "prompts": "^2.4.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/prompts": "^2.4.9",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sreeju7733/bharatcode-mcp.git"
  }
}
