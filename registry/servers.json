{
  "schemaVersion": "1",
  "minCliVersion": "1.0.0",
  "presets": {
    "core": ["git", "filesystem", "local-docs"],
    "fullstack": ["git", "filesystem", "postgres", "sqlite", "fetch", "local-docs"],
    "browser": ["git", "playwright", "puppeteer", "fetch", "local-docs"],
    "data": ["postgres", "sqlite"],
    "devops": ["git", "github", "filesystem"]
  },
  "servers": {
    "git": {
      "description": "Local Git repository inspection, diffs, and branch history",
      "runtime": "uvx",
      "command": "uvx",
      "args": ["mcp-server-git", "--repository", "."],
      "requiredEnv": [],
      "optionalEnv": []
    },
    "filesystem": {
      "description": "Scoped file read/write/search inside the active workspace",
      "runtime": "npx",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "."],
      "requiredEnv": [],
      "optionalEnv": []
    },
    "playwright": {
      "description": "Headless browser automation and accessibility tree snapshots",
      "runtime": "npx",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"],
      "requiredEnv": [],
      "optionalEnv": []
    },
    "puppeteer": {
      "description": "Browser automation and web console log inspection via Puppeteer",
      "runtime": "npx",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-puppeteer"],
      "requiredEnv": [],
      "optionalEnv": []
    },
    "postgres": {
      "description": "Read-only schema inspection and SQL querying for Postgres",
      "runtime": "npx",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres"],
      "requiredEnv": ["POSTGRES_URL"],
      "optionalEnv": []
    },
    "sqlite": {
      "description": "Local SQLite database querying, schema inspection, and table analysis",
      "runtime": "npx",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sqlite", "--db-path", "./data.db"],
      "requiredEnv": [],
      "optionalEnv": []
    },
    "fetch": {
      "description": "Fetch web pages and convert HTML content into clean markdown for context",
      "runtime": "uvx",
      "command": "uvx",
      "args": ["mcp-server-fetch"],
      "requiredEnv": [],
      "optionalEnv": []
    },
    "github": {
      "description": "Search repositories, inspect pull requests, and manage issues via GitHub API",
      "runtime": "npx",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "requiredEnv": ["GITHUB_PERSONAL_ACCESS_TOKEN"],
      "optionalEnv": []
    },
    "brave-search": {
      "description": "Real-time web search and news querying powered by the Brave Search API",
      "runtime": "npx",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-brave-search"],
      "requiredEnv": ["BRAVE_API_KEY"],
      "optionalEnv": []
    },
    "local-docs": {
      "description": "Indexes project READMEs, /docs, and OpenAPI specs locally",
      "runtime": "npx",
      "command": "npx",
      "args": ["-y", "bharatcode-local-docs-mcp", "--dir", "./docs"],
      "requiredEnv": [],
      "optionalEnv": [],
      "comingSoon": true
    }
  }
}
